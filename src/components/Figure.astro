---
/*
 * 註にはさむ図。
 *
 * ⚠ **絵はここにしかありません。** 記事データ（yaml）が持つのは「どこに・どの図を・
 *    どういう説明で」の 3 つだけです。SVG を yaml に書くと、記事データが生の HTML
 *    置き場になります（src/lib/entries.ts の Figure の註釈を参照）。
 * ⚠ 色は変数だけ。しかも**役割を固定**します: 青 = 元のまま / 緑 = 足された・届いた /
 *    赤 = 消える・届かない。図をまたいで同じ意味にしないと、読み手が毎回覚え直します。
 */
import type { Figure } from '../lib/entries';
const { kind, caption } = Astro.props as Figure;
---

<figure class="fig">
  {kind === 'bytes' && (
    <svg viewBox="0 0 700 290" role="img" aria-label="打つ前は 12,617 バイト。打った後は 16,117 バイト。元の本文の青い部分は同じ大きさのまま残り、上に緑の 3,500 バイトが足されている">
      <text x="150" y="46" class="f-num">12,617 バイト</text>
      <text x="470" y="46" class="f-num">16,117 バイト</text>

      <rect x="85" y="90" width="130" height="130" class="f-keep" />
      <text x="150" y="162" class="f-mini t-keep">元の本文</text>
      <text x="150" y="248" class="f-cap">打つ前</text>

      <line x1="240" y1="155" x2="368" y2="155" class="f-line" />
      <polygon points="382,155 364,147 364,163" class="f-arrow" />
      <text x="308" y="140" class="f-mini">/init を打つ</text>

      <rect x="405" y="90" width="130" height="130" class="f-keep" />
      <text x="470" y="162" class="f-mini t-keep">元の本文</text>
      <rect x="405" y="57" width="130" height="33" class="f-add" />
      <text x="470" y="248" class="f-cap">打った後</text>

      <path d="M215 90 L405 90" class="f-tie" />
      <path d="M215 220 L405 220" class="f-tie" />

      <text x="556" y="79" class="f-mini f-left t-add">＋3,500 足された</text>
      <text x="556" y="150" class="f-mini f-left t-keep">高さが同じ</text>
      <text x="556" y="170" class="f-mini f-left">＝一行も消えていない</text>
    </svg>
  )}

  {kind === 'write-edit' && (
    <svg viewBox="0 0 700 350" role="img" aria-label="もし Write なら元の青い行は消えて別の行に置き換わる。実際に使われた Edit は元の青い行を残したまま緑の行を足す">
      <g class="f-faint">
        <text x="24" y="34" class="f-cap f-left">もし Write だったら</text>
        <rect x="24" y="52" width="104" height="118" class="f-paper" />
        <g class="l-keep"><rect x="40" y="70" width="72" height="7" /><rect x="40" y="86" width="72" height="7" /><rect x="40" y="102" width="52" height="7" /><rect x="40" y="118" width="72" height="7" /></g>
        <line x1="146" y1="111" x2="186" y2="111" class="f-line" />
        <polygon points="200,111 182,103 182,119" class="f-arrow" />
        <rect x="216" y="52" width="104" height="118" class="f-gone" />
        <g class="l-new"><rect x="232" y="70" width="72" height="7" /><rect x="232" y="86" width="56" height="7" /><rect x="232" y="102" width="72" height="7" /></g>
        <line x1="232" y1="130" x2="304" y2="152" class="f-x" />
        <line x1="304" y1="130" x2="232" y2="152" class="f-x" />
        <text x="172" y="196" class="f-mini">紙をまるごと書き直す</text>
        <text x="172" y="216" class="f-mini t-gone">元の行は残らない</text>
      </g>

      <text x="380" y="34" class="f-cap f-left t-add">実際は Edit だった</text>
      <rect x="380" y="52" width="104" height="118" class="f-paper" />
      <g class="l-keep"><rect x="396" y="70" width="72" height="7" /><rect x="396" y="86" width="72" height="7" /><rect x="396" y="102" width="52" height="7" /><rect x="396" y="118" width="72" height="7" /></g>
      <line x1="502" y1="111" x2="542" y2="111" class="f-line" />
      <polygon points="556,111 538,103 538,119" class="f-arrow" />
      <rect x="572" y="52" width="104" height="118" class="f-paper" />
      <g class="l-keep"><rect x="588" y="70" width="72" height="7" /><rect x="588" y="86" width="72" height="7" /><rect x="588" y="102" width="52" height="7" /><rect x="588" y="118" width="72" height="7" /></g>
      <g class="l-add"><rect x="588" y="134" width="60" height="7" /><rect x="588" y="150" width="44" height="7" /></g>
      <text x="528" y="196" class="f-mini">一部だけ書き足す</text>
      <text x="528" y="216" class="f-mini t-keep">元の行はそのまま</text>

      <line x1="352" y1="20" x2="352" y2="230" class="f-tie" />

      <g>
        <rect x="24" y="266" width="18" height="9" class="f-keep" />
        <text x="52" y="275" class="f-mini f-left t-keep">元からある行</text>
        <rect x="200" y="266" width="18" height="9" class="f-add" />
        <text x="228" y="275" class="f-mini f-left t-add">足された行</text>
        <rect x="368" y="266" width="18" height="9" class="f-gone" />
        <text x="396" y="275" class="f-mini f-left t-gone">消えてしまう側</text>
      </g>
      <text x="24" y="316" class="f-mini f-left">/init が使ったのは右。だから 12 KB の本文が残った。</text>
    </svg>
  )}

  {kind === 'reading-order' && (
    <svg viewBox="0 0 700 260" role="img" aria-label="30 手のうち 29 手は読むだけで、書くのは最後の 1 手。CLAUDE.md を読むのは 2 手目">
      <text x="300" y="40" class="f-cap">読むだけ　29 手</text>
      <text x="644" y="40" class="f-cap t-add">書く 1 手</text>

      <rect x="40" y="58" width="562" height="42" class="f-keep" />
      <rect x="602" y="58" width="58" height="42" class="f-add" />

      <text x="631" y="85" class="f-mini t-add">Edit ×3</text>

      <line x1="78" y1="100" x2="78" y2="128" class="f-tie" />
      <text x="78" y="148" class="f-mini">場所を見る</text>
      <text x="78" y="166" class="f-mini">ls・find</text>

      <line x1="190" y1="100" x2="190" y2="128" class="f-line" />
      <text x="190" y="148" class="f-cap t-keep">CLAUDE.md</text>
      <text x="190" y="166" class="f-mini t-keep">2 手目に読む</text>

      <line x1="305" y1="100" x2="305" y2="128" class="f-tie" />
      <text x="305" y="148" class="f-mini">部品の一覧</text>

      <line x1="400" y1="100" x2="400" y2="128" class="f-tie" />
      <text x="400" y="148" class="f-mini">設定・命令</text>

      <line x1="483" y1="100" x2="483" y2="128" class="f-tie" />
      <text x="483" y="148" class="f-mini">自動検査</text>

      <line x1="566" y1="100" x2="566" y2="128" class="f-tie" />
      <text x="566" y="148" class="f-mini">本体・他の AI</text>

      <text x="350" y="214" class="f-mini">書く前にこれだけ読む。書くのは最後のひと押しだけ。</text>
    </svg>
  )}

  {kind === 'md-tree' && (
    <svg viewBox="0 0 700 390" role="img" aria-label="フォルダの入れ子の図。作業を始めた kamechannel の CLAUDE.md と、上にたどった先のホームの CLAUDE.md は読まれる。途中のブログ関係フォルダには CLAUDE.md が無いので素通りする。kamechannel の下の src の CLAUDE.md と、横に並ぶ onakenblog の CLAUDE.md は読まれない。ホームの .claude の CLAUDE.md はどこで作業しても読まれる">
      {/* 上へたどる矢印 */}
      <line x1="26" y1="255" x2="26" y2="96" class="f-line" />
      <polygon points="26,82 18,100 34,100" class="f-arrow" />
      <text transform="rotate(-90 12 180)" x="12" y="180" class="f-mini">上へたどる</text>

      {/* ホーム */}
      <text x="46" y="40" class="f-mini f-left">~/（ホーム）</text>

      {/* 枝: ホームの子 */}
      <line x1="58" y1="46" x2="58" y2="163" class="f-tie" />
      <line x1="58" y1="75"  x2="72" y2="75"  class="f-tie" />
      <line x1="58" y1="119" x2="72" y2="119" class="f-tie" />
      <line x1="58" y1="163" x2="72" y2="163" class="f-tie" />

      {/* .claude/CLAUDE.md — 別枠 */}
      <rect x="72" y="58" width="378" height="34" rx="6" class="f-add" />
      <text x="88" y="81" class="f-mini f-left t-add">.claude/CLAUDE.md</text>
      <text x="470" y="81" class="f-mini f-left t-add">★ 別枠。いつでも読まれる</text>

      {/* ~/CLAUDE.md */}
      <rect x="72" y="102" width="378" height="34" rx="6" class="f-add" />
      <text x="88" y="125" class="f-mini f-left t-add">CLAUDE.md</text>
      <text x="470" y="125" class="f-mini f-left t-add">読まれる</text>

      {/* ブログ関係/ — フォルダ（枠なし） */}
      <text x="88" y="169" class="f-mini f-left">ブログ関係/</text>
      <text x="470" y="169" class="f-mini f-left">無いので素通り</text>

      {/* 枝: ブログ関係の子 */}
      <line x1="90" y1="176" x2="90" y2="339" class="f-tie" />
      <line x1="90" y1="207" x2="104" y2="207" class="f-tie" />
      <line x1="90" y1="339" x2="104" y2="339" class="f-tie" />

      {/* kamechannel/ — フォルダ（枠なし） */}
      <text x="120" y="213" class="f-mini f-left">kamechannel/</text>
      <text x="470" y="213" class="f-mini f-left">▶ ここで作業を始めた</text>

      {/* 枝: kamechannel の子 */}
      <line x1="122" y1="220" x2="122" y2="295" class="f-tie" />
      <line x1="122" y1="251" x2="136" y2="251" class="f-tie" />
      <line x1="122" y1="295" x2="136" y2="295" class="f-tie" />

      {/* kamechannel/CLAUDE.md */}
      <rect x="136" y="234" width="314" height="34" rx="6" class="f-add" />
      <text x="152" y="257" class="f-mini f-left t-add">CLAUDE.md</text>
      <text x="470" y="257" class="f-mini f-left t-add">読まれる</text>

      {/* src/CLAUDE.md — 子 */}
      <rect x="136" y="278" width="314" height="34" rx="6" class="f-gone" />
      <text x="152" y="301" class="f-mini f-left t-gone">src/CLAUDE.md</text>
      <text x="470" y="301" class="f-mini f-left t-gone">読まれない（下は見ない）</text>

      {/* onakenblog/CLAUDE.md — 横 */}
      <rect x="104" y="322" width="346" height="34" rx="6" class="f-gone" />
      <text x="120" y="345" class="f-mini f-left t-gone">onakenblog/CLAUDE.md</text>
      <text x="470" y="345" class="f-mini f-left t-gone">読まれない（横も見ない）</text>

      <text x="26" y="380" class="f-mini f-left">作業を始めた場所から、上へたどって拾います。下と横は見ません</text>
    </svg>
  )}

  {kind === 'aikotoba' && (
    <svg viewBox="0 0 700 380" role="img" aria-label="6 か所に隠した言葉のうち、起動したフォルダの本文、起動したフォルダからアットマークで呼んだ先、親フォルダの本文の 3 つが届いた。親フォルダからアットマークで呼んだ先は相対パスでも絶対パスでも届かず、隣の兄弟フォルダの本文も届かなかった">
      <text x="30" y="30" class="f-mini f-left">言葉を隠した場所</text>
      <text x="560" y="30" class="f-mini f-left">結果</text>
      <line x1="30" y1="42" x2="670" y2="42" class="f-line" />

      <rect x="30" y="58" width="500" height="40" rx="6" class="f-add" />
      <text x="48" y="83" class="f-mini f-left t-add">起動したフォルダの CLAUDE.md 本文</text>
      <text x="560" y="83" class="f-mini f-left t-add">届いた</text>

      <rect x="30" y="108" width="500" height="40" rx="6" class="f-add" />
      <text x="48" y="133" class="f-mini f-left t-add">起動したフォルダから @ で呼んだ先</text>
      <text x="560" y="133" class="f-mini f-left t-add">届いた</text>

      <rect x="30" y="158" width="500" height="40" rx="6" class="f-add" />
      <text x="48" y="183" class="f-mini f-left t-add">親フォルダの CLAUDE.md 本文</text>
      <text x="560" y="183" class="f-mini f-left t-add">届いた</text>

      <rect x="30" y="212" width="500" height="40" rx="6" class="f-gone" />
      <text x="48" y="237" class="f-mini f-left t-gone">親フォルダから @ で呼んだ先（相対パス）</text>
      <text x="560" y="237" class="f-mini f-left t-gone">届かない</text>

      <rect x="30" y="262" width="500" height="40" rx="6" class="f-gone" />
      <text x="48" y="287" class="f-mini f-left t-gone">親フォルダから @ で呼んだ先（絶対パス）</text>
      <text x="560" y="287" class="f-mini f-left t-gone">届かない</text>

      <rect x="30" y="312" width="500" height="40" rx="6" class="f-gone" />
      <text x="48" y="337" class="f-mini f-left t-gone">隣の兄弟フォルダの CLAUDE.md 本文</text>
      <text x="560" y="337" class="f-mini f-left t-gone">届かない</text>

      <text x="30" y="372" class="f-mini f-left">上の 3 つが緑だから、下の 3 つを「届かなかった」と言い切れます（陽性対照）</text>
    </svg>
  )}

  {kind === 'atmark' && (
    <svg viewBox="0 0 700 300" role="img" aria-label="起動したフォルダの CLAUDE.md に書いたアットマークの行は、呼んだ先のファイルの中身に置き換わる。上に遡って読まれた親の CLAUDE.md に書いたアットマークの行は、置き換わらずそのまま">
      <text x="150" y="34" class="f-cap">起動したフォルダに書いたとき</text>
      <rect x="30" y="52" width="240" height="76" rx="6" class="f-paper" />
      <text x="46" y="80" class="f-mini f-left">起動したフォルダの CLAUDE.md</text>
      <text x="46" y="106" class="f-mini f-left t-add">@./yonda.md</text>

      <line x1="150" y1="140" x2="150" y2="176" class="f-line" />
      <polygon points="150,190 142,172 158,172" class="f-arrow" />

      <rect x="30" y="200" width="240" height="60" rx="6" class="f-add" />
      <text x="150" y="224" class="f-mini t-add">中身に置き換わった</text>
      <text x="150" y="244" class="f-mini t-add">（呼んだ先の言葉が届いた）</text>

      <line x1="350" y1="52" x2="350" y2="270" class="f-tie" />

      <text x="550" y="34" class="f-cap">上に遡って読まれたほうに書いたとき</text>
      <rect x="430" y="52" width="240" height="76" rx="6" class="f-paper" />
      <text x="446" y="80" class="f-mini f-left">親フォルダの CLAUDE.md</text>
      <text x="446" y="106" class="f-mini f-left t-gone">@/Users/…/yonda.md</text>

      <line x1="550" y1="140" x2="550" y2="176" class="f-line" />
      <polygon points="550,190 542,172 558,172" class="f-arrow" />

      <rect x="430" y="200" width="240" height="60" rx="6" class="f-gone" />
      <text x="550" y="224" class="f-mini t-gone">置き換わらなかった</text>
      <text x="550" y="244" class="f-mini t-gone">（絶対パスにしても同じ）</text>

      <text x="30" y="288" class="f-mini f-left">同じ一行。違うのは、書いてある CLAUDE.md がどっちか、だけ</text>
    </svg>
  )}

  {kind === 'hyoshiki' && (
    <svg viewBox="0 0 700 396" role="img" aria-label="CLAUDE.md は道路標識、Hooks は踏切の遮断機。標識は立ててある看板で、運転手が読んで守る。守らなくてもその場では何も起きない。書けるのは意味で、何百種類でも立てられる。遮断機は機械で、装置が勝手に降りる。守らなければ物理的に通れない。書けるのは通す通さないの形だけで、線路がある場所にしか作れない">
      <text x="290" y="30" class="f-cap t-keep">標識 ＝ CLAUDE.md</text>
      <text x="560" y="30" class="f-cap t-gone">遮断機 ＝ Hooks</text>
      <line x1="30" y1="44" x2="670" y2="44" class="f-line" />

      <line x1="418" y1="52" x2="418" y2="352" class="f-tie" />

      <text x="30" y="76" class="f-mini f-left">正体</text>
      <text x="170" y="76" class="f-mini f-left t-keep">立ててある看板</text>
      <text x="440" y="76" class="f-mini f-left t-gone">機械</text>

      <text x="30" y="124" class="f-mini f-left">誰が実行する</text>
      <text x="170" y="124" class="f-mini f-left t-keep">運転手が読んで守る</text>
      <text x="440" y="124" class="f-mini f-left t-gone">装置が勝手に降りる</text>

      <text x="30" y="172" class="f-mini f-left">守らなかったら</text>
      <text x="170" y="172" class="f-mini f-left t-keep">その場では何も起きない</text>
      <text x="440" y="172" class="f-mini f-left t-gone">物理的に通れない</text>

      <text x="30" y="220" class="f-mini f-left">書けること</text>
      <text x="170" y="220" class="f-mini f-left t-keep">この先カーブ、歩行者優先</text>
      <text x="170" y="240" class="f-mini f-left t-keep">＝意味</text>
      <text x="440" y="220" class="f-mini f-left t-gone">通す／通さない</text>
      <text x="440" y="240" class="f-mini f-left t-gone">＝形</text>

      <text x="30" y="288" class="f-mini f-left">言えること</text>
      <text x="170" y="288" class="f-mini f-left t-keep">「こうして」</text>
      <text x="440" y="288" class="f-mini f-left t-gone">「ダメ」だけ</text>

      <text x="30" y="336" class="f-mini f-left">数</text>
      <text x="170" y="336" class="f-mini f-left t-keep">何百種類でも立てられる</text>
      <text x="440" y="336" class="f-mini f-left t-gone">線路がある場所にしか</text>
      <text x="440" y="356" class="f-mini f-left t-gone">作れない</text>

      <text x="30" y="388" class="f-mini f-left">標識は読んでほしいこと。遮断機は絶対に通してはいけないところ</text>
    </svg>
  )}

  <figcaption>{caption}</figcaption>
</figure>
