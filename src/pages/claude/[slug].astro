---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entries, findItem, KIND_LABEL, toSegments, tightenSegments, tighten, plain } from '../../lib/entries';
import { SITE_NAME } from '../../lib/site';
import Figure from '../../components/Figure.astro';

export function getStaticPaths() {
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const item = findItem(entry.sourceId);

/*
 * 註は素の段落として出す。装飾を足さないこと。
 * 検証 K9 が「note が実際にページへ出ているか」を dist で確かめています。
 */
const paragraphs = entry.note.trim().split(/\n{2,}/);

/*
 * あわせて読む。データが持つのは slug だけで、題は記事本体から引く。
 * ⚠ 題をデータに書き写さないこと。書き写すと題を直したときに片方だけ古くなります。
 *    無い slug は検証 K11 が落とすので、ここに来る時点で必ず見つかります。
 */
const related = (entry.seeAlso ?? []).flatMap((s) => {
  const m = entries.find((e) => e.slug === s);
  return m ? [m] : [];
});
---

<BaseLayout
  title={`${entry.title} — ${SITE_NAME}`}
  {/* 検索結果やリンク先の見出しに出る一行。記法を外してから詰め、残った改行は
      空白 1 個に畳む（属性の中に生の改行が入ると、そのまま外へ出てしまう） */}
  description={tighten(plain(entry.note.trim())).replace(/\s+/g, ' ').slice(0, 110)}
  path={`/claude/${entry.slug}/`}
>
  <article>
    <h1>{entry.title}</h1>
    <p class="meta">
      <span class="kind">{item ? KIND_LABEL[item.kind] : ''}</span>
      <span class="sid">{entry.sourceId}</span>
      <time datetime={entry.publishedAt}>{entry.publishedAt}</time>
      {entry.reviewed === false && <span class="draft">下書き</span>}
    </p>

    {/* ループちゃんの一言。記事の頭の吹き出し（2026-09-14 追加）。
        ⚠ class="note" を付けないこと。K9・K12 は <p class="note"> を註の段落として数えるので、
           ここに付けると註が 1 段落増えたことになります。 */}
    <aside class="loop">
      <img class="loop-face" src="/loop/face-studying.png" alt="ループちゃん" width="56" height="56" />
      <p class="loop-b">{tighten(entry.loopSays)}</p>
    </aside>

    {paragraphs.map((p, pi) => (
      <>
      <p class="note">
        {tightenSegments(toSegments(p)).map((s, si) =>
          s.gloss ? (
            /* 言い換え。既定は畳んである。用語を押した/触れたときだけ出す。
               ⚠ popover は素の HTML の機能で、JavaScript を1行も足していない。 */
            /* ⚠ 目印の名前は用語ごとに変える。全部同じ名前にすると、どのカードも
                  ページ最後の用語にぶら下がって画面外に飛ぶ（2026-09-08 に踏んだ）。 */
            <>
              <button type="button" class="gl" popovertarget={`gl-${pi}-${si}`}
                aria-describedby={`gl-${pi}-${si}`}
                style={`anchor-name:--gl-${pi}-${si}`}>
                {s.code ? <code>{s.text}</code> : s.text}
              </button>
              <span class="gl-t" popover id={`gl-${pi}-${si}`}
                style={`position-anchor:--gl-${pi}-${si}`}>
                {/* 説明はループちゃんが話す形で出す（2026-09-14）。文そのものは人が書いた
                    「です・ます」のまま。顔は飾りなので alt は空（話し手の名前は札の見出しが言う）。 */}
                <img class="gl-face" src="/loop/face-focus.png" alt="" width="44" height="44" />
                {/* 用語名を札の中にも出す。画面が狭いと札が用語から離れた所に出るため、
                    何の説明かが札だけで分かるようにしておく。 */}
                <b class="gl-n">{s.text}</b>
                <span class="gl-b">{s.gloss}</span>
              </span>
            </>
          )
            : s.strong ? <strong>{s.text}</strong>
            : s.code ? <code>{s.text}</code>
            : s.text
        )}
      </p>
      {/* この段落の後ろに置く図。データが持つのは置き場所と説明だけ（Figure.astro が絵） */}
      {(entry.figures ?? []).filter((f) => f.after === pi + 1)
        .map((f) => <Figure kind={f.kind} after={f.after} caption={tighten(f.caption)} />)}
      </>
    ))}

    {item?.credit && (
      <p class="credit"><strong>出典:</strong> {item.credit}</p>
    )}

    {related.length > 0 && (
      <nav class="see-also">
        <h2>あわせて読む</h2>
        <ul>
          {related.map((r) => (
            <li><a href={`/claude/${r.slug}/`}>{r.title}</a></li>
          ))}
        </ul>
      </nav>
    )}
  </article>
  <p><a href="/">← 一覧へ</a></p>
</BaseLayout>
