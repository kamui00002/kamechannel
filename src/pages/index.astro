---
import BaseLayout from '../layouts/BaseLayout.astro';
import { entries, findItem, KIND_LABEL } from '../lib/entries';
---

<BaseLayout
  title="KaMeChannel — Claude Code を AI と一緒に学ぶ記録"
  description="Claude Code を使っていて分からなかったことを、AI と一緒に調べながら学んでいます。試したことも、勘違いしていたことも、そのまま書いています。"
  path="/"
>
  <h1>KaMeChannel</h1>
  {/* ⚠ ここは方針そのもの。catalog の builtins を増やす路線に変えたとき（2026-09-08）、
      この文だけ「~/.claude のスキルを取り上げる」の古いままだった。
      載せるものを変えるときは、この文も一緒に直すこと。 */}
  <p class="lead">
    Claude Code を使っていて「これ、どういうこと？」と思ったことを、
    <strong>AI と一緒に学んだ記録</strong>を残していきます！
    ちゃんと試してから書くので、うまくいかなかったことや、
    勘違いしていたことも、そのまま置いてあります。
  </p>

  <ul class="list">
    {entries.map((e) => {
      const item = findItem(e.sourceId);
      return (
        <li class="row">
          <a class="row-t" href={`/claude/${e.slug}/`}>{e.title}</a>
          <p class="row-m">
            <span class="kind">{item ? KIND_LABEL[item.kind] : ''}</span>
            <time datetime={e.publishedAt}>{e.publishedAt}</time>
            {e.reviewed === false && <span class="draft">下書き</span>}
          </p>
        </li>
      );
    })}
  </ul>
</BaseLayout>
