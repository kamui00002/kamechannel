---
/*
 * すべてのページの外枠。
 *
 * ■ 意匠は「大判」を当ててある（2026-09-09 決定）
 *   原典は design-variants/kamechannel/05-typo.html と 08-reactive.html。
 *   刷り色の役割と、明色版を持たない理由は public/styles/global.css の冒頭に書いてある。
 *   **ここに場当たりの装飾を足さないこと。** 足すなら方針を決めてから。
 */
import { SITE_NAME, SITE_NAME_PARTS } from '../lib/site';

export interface Props {
  title: string;
  description?: string;
  /** サイトルートからの絶対パス。末尾スラッシュ付き（trailingSlash: 'always'）。 */
  path: string;
}

const { title, description = '', path } = Astro.props;
const canonical = new URL(path, Astro.site).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="stylesheet" href="/styles/global.css" />
    <script is:inline>
      /*
       * 動きの合図だけを付ける小さな仕掛け。
       *
       * ⚠ **順番が命。** 既定は「動いた後の姿」で、この JS が動いたときだけ隠す。
       *    先に隠してから JS で出す作りにすると、JS が動かない場で本文が
       *    透明のまま消える。2026-09-09 に実際そうなった（描画の止まった枠で全消え）。
       * ⚠ 保険を 2 つ置く。合図が一度も来なければ全部出す。読めることが動きより上。
       * ⚠ 動きを望まない設定の人には .mo を付けない（＝一切動かない）。
       */
      (function () {
        if (!('IntersectionObserver' in window)) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('mo');
        var els = [], fired = false;
        function revealAll() { els.forEach(function (e) { e.classList.add('in'); }); }
        function start() {
          els = [].slice.call(document.querySelectorAll('.note, .fig, .row'));
          var io = new IntersectionObserver(function (es) {
            es.forEach(function (e) {
              if (e.isIntersecting) { fired = true; e.target.classList.add('in'); io.unobserve(e.target); }
            });
          }, { threshold: 0.15 });
          els.forEach(function (el) { io.observe(el); });
          setTimeout(function () { if (!fired) { io.disconnect(); revealAll(); } }, 1200);
        }
        if (document.readyState === 'loading') addEventListener('DOMContentLoaded', start);
        else start();
        addEventListener('load', function () { setTimeout(function () { if (!fired) revealAll(); }, 1400); });
      })();
    </script>
  </head>
  <body>
    <header class="head">
      {/* 名前が長いので、狭い画面では語の切れ目（<wbr>）でだけ折り返す（CSS の .head-t が keep-all） */}
      <a class="head-t" href="/">{SITE_NAME_PARTS.map((p, i) => <>{i > 0 && <wbr />}{p}</>)}</a>
    </header>
    <main class="main">
      <slot />
    </main>
    <footer class="foot">
      <p class="micro">© {SITE_NAME}</p>
    </footer>
  </body>
</html>
