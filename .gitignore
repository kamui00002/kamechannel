# Claude Code の Browser ペイン用 dev サーバー設定（各人のローカル環境の話で、
# サイトの中身ではない）。⚠ `.claude/` ごと無視しないこと — ディレクトリを丸ごと
# 伏せると、あとで .claude/ に置いたファイルが git status に出なくなります。
# それは §3 で退けた「除外リスト方式」と同じ形（黙って隠れる）です。
.claude/launch.json

# セッション間の引き継ぎノート（手元の作業メモで、サイトの中身ではない）。
# ⚠ ここに入れる理由は「散らかるから」ではありません。このリポジトリは public で、
#   ノートには退避先の実パス（/Users/<利用者名>/…）が普通に出ます。そして K5/K7 の
#   ローカルパス検査は src/ と dist/ しか見ていないので、.claude/ は誰も見張りません。
#   一度 push すれば履歴からは消せないので、入口で止めます（2026-09-12 運営者の判断）。
.claude/handoffs/

# Firebase の CLI / MCP がリポジトリ直下に吐くデバッグログ。
# ⚠ 中身に署名中の Google アカウントのメールアドレスが入ります（2026-09-16 の実物で確認）。
#   このリポジトリは public で、K5 は src/data、K7 は dist しか見ないので、直下に落ちる
#   このファイルは誰も見張りません。一度コミットすれば履歴からは消せないので、入口で
#   止めます（2026-09-17 運営者の判断）。
# ⚠ emulator 系の firestore-debug.log / ui-debug.log は、この 1 行では止まりません。
firebase-debug.log
